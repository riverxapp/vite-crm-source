# App
VITE_APP_NAME=
VITE_API_BASE_URL=

# Database (injected by RiverX — leave empty here)
VITE_RIVERX_DB_URL=
VITE_RIVERX_DB_KEY=

# Local development outside RiverX only (never prefix with VITE_, never commit).
# Put them in .env (gitignored). When set and VITE_RIVERX_DB_URL is empty, `pnpm dev` serves a local Data API proxy.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
