# App
VITE_APP_NAME=
# Leave empty: defaults to /__local-api in dev (RiverX routes /api/* to itself), /api in production.
VITE_API_BASE_URL=

# Database (injected by RiverX — leave empty here)
VITE_RIVERX_DB_URL=
VITE_RIVERX_DB_KEY=

# Outside RiverX only (never prefix with VITE_, never commit).
# Locally: put them in .env (gitignored); `pnpm dev` then serves a local Data API proxy.
# On Vercel: set them in the project's Environment Variables; the app uses /api/db and /api/auth.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
