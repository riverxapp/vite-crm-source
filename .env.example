# App
VITE_APP_NAME=
# Leave empty: defaults to /__local-api in dev (RiverX routes /api/* to itself), /api in production.
VITE_API_BASE_URL=

# Database (injected by RiverX for the dev server — leave empty here; production builds ignore them)
VITE_RIVERX_DB_URL=
VITE_RIVERX_DB_KEY=

# Server only (never prefix with VITE_, never commit). Set them yourself outside RiverX.
# Locally: put them in .env (gitignored); `pnpm dev` then serves a local Data API proxy.
# On Vercel: set them in the project's Environment Variables (publishing from RiverX sets them); the app uses /api/db and /api/auth.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
